<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- ================================================================
       四轮全驱 skid-steer（按实车建）
       ================================================================
       左右各两个驱动轮，全部由 DiffDrive 驱动，没有万向轮。

       为什么这样能同时解决之前两个问题：
       1) 翘头：支撑多边形在 x 方向横跨前后轴（±wheel_offset_x），
          抬头要绕后轴翻转，恢复力矩 m*g*wheel_offset_x ≈ 8.9 N·m，
          而之前两轮+万向轮时只有 0.3 N·m，所以再也不会翘。
          雷达不俯仰，自然也不会扫到地面。
       2) 原地旋转的里程计误差：四轮平行，原地转时每个轮子都必须
          横向刮擦，编码器积分出来的转角必然与车体真实转角不符。
          这是 skid-steer 的固有特性，实车同样存在，所以这里**保留**
          而不是消除——让上层的 SLAM/Nav2 面对和实车一样的里程计质量。

       ★★ 下面这一段 property 是本工程**唯一**依赖实车实测数据的地方。
          全部是按 0.4×0.3 底盘估的占位值，不是实测值。

          拿到实车数据后怎么改：
            1. 只改这一段（几何 / 质量 / 限速 / 摩擦 / 雷达，共 5 组）；
            2. 不用 colcon build —— install 是符号链接，直接指向本文件；
            3. 重启 launch 即可生效。

          改哪个值要连带改哪里（Nav2、SLAM），见 docs/real_robot_params.md。
          最要紧的是 wheel_offset_x（半轴距）和雷达安装高度 / 量程。
       ================================================================ -->
  <xacro:property name="base_length"  value="0.4"/>
  <xacro:property name="base_width"   value="0.3"/>
  <xacro:property name="base_height"  value="0.15"/>
  <xacro:property name="base_mass"    value="5.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.03"/>
  <xacro:property name="wheel_mass"   value="0.35"/>
  <xacro:property name="wheel_offset_x" value="0.14"/>  <!-- 半轴距，实车轴距 = 0.28 -->
  <xacro:property name="wheel_offset_y" value="0.17"/>  <!-- 半轮距，实车轮距 = 0.34 -->
  <xacro:property name="wheel_offset_z" value="-0.05"/>

  <!-- skid-steer 的摩擦各向异性。
       真实轮子横向阻力比纵向小得多（胎面/接触面变形），这个比值直接决定
       原地旋转时打滑多少。先用 1.0 / 0.5 起步，实测出来的 odom/true 比值
       要和实车对比后再调——真实值只能靠实车标定。 -->
  <xacro:property name="wheel_mu_long" value="1.0"/>   <!-- 沿滚动方向 -->
  <xacro:property name="wheel_mu_lat"  value="0.5"/>   <!-- 垂直滚动方向 -->

  <!-- ★ 速度/加速度上限：实车实测值待填。
       注意这些才是 gz-sim 8 真正认的参数；之前 URDF 里的
       max_wheel_torque / max_wheel_acceleration 在 8.15.0 的 DiffDrive
       文档和二进制里都不存在，写了也从来没生效过。 -->
  <xacro:property name="max_linear_vel"  value="0.5"/>
  <xacro:property name="max_angular_vel" value="1.5"/>
  <xacro:property name="max_linear_acc"  value="0.5"/>
  <xacro:property name="max_angular_acc" value="2.0"/>

  <!-- ★ 雷达参数：同样是占位值，从未和实车雷达核对过。
       雷达装高一点（比如 0.25）能少扫到地面；量程和角度要按实车型号改，
       否则 SLAM 会把真实存在的墙当成"超出量程"而丢掉。 -->
  <xacro:property name="lidar_mount_x"  value="0.0"/>    <!-- 相对 base_link -->
  <xacro:property name="lidar_mount_y"  value="0.0"/>
  <xacro:property name="lidar_mount_z"  value="0.12"/>
  <xacro:property name="lidar_samples"  value="360"/>    <!-- 水平线数 -->
  <xacro:property name="lidar_min_angle" value="-3.14159"/>
  <xacro:property name="lidar_max_angle" value="3.14159"/>
  <xacro:property name="lidar_range_min" value="0.1"/>
  <xacro:property name="lidar_range_max" value="12.0"/>
  <xacro:property name="lidar_update_rate" value="10"/>  <!-- Hz -->
  <xacro:property name="lidar_noise_stddev" value="0.01"/> <!-- m -->

  <!-- ========== 驱动轮宏 ========== -->
  <xacro:macro name="drive_wheel" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.0005" ixy="0" ixz="0"
                 iyy="0.0005" iyz="0"
                 izz="0.0005"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_offset_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- fdir1 在碰撞体坐标系里表达；碰撞体只绕 x 转了 90°，
         所以 x 轴不变，fdir1=1 0 0 就是轮子的滚动方向。 -->
    <gazebo reference="${name}">
      <surface>
        <friction>
          <ode>
            <mu>${wheel_mu_long}</mu>
            <mu2>${wheel_mu_lat}</mu2>
            <fdir1>1 0 0</fdir1>
          </ode>
        </friction>
      </surface>
    </gazebo>
  </xacro:macro>

  <!-- ========== 底盘 ========== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="blue">
        <color rgba="0.2 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia ixx="0.05" ixy="0" ixz="0"
               iyy="0.08" iyz="0"
               izz="0.1"/>
    </inertial>
  </link>

  <!-- ========== 四个驱动轮 ========== -->
  <xacro:drive_wheel name="front_left_wheel"  x="${wheel_offset_x}"  y="${wheel_offset_y}"/>
  <xacro:drive_wheel name="rear_left_wheel"   x="-${wheel_offset_x}" y="${wheel_offset_y}"/>
  <xacro:drive_wheel name="front_right_wheel" x="${wheel_offset_x}"  y="-${wheel_offset_y}"/>
  <xacro:drive_wheel name="rear_right_wheel"  x="-${wheel_offset_x}" y="-${wheel_offset_y}"/>

  <!-- ========== 激光雷达 ========== -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_mount_x} ${lidar_mount_y} ${lidar_mount_z}" rpy="0 0 0"/>
  </joint>

  <!-- ========== Gazebo 差速驱动插件 ==========
       一侧挂两个 joint 是官方支持的：文档明确写
       "can be attached to a model with any number of left and right wheels"，
       且 <left_joint>/<right_joint> "can appear multiple times"。
       wheel_separation 仍然是左右轮距（0.34），与轴距无关。 -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${2 * wheel_offset_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <topic>cmd_vel</topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>${max_linear_vel}</max_linear_velocity>
      <max_angular_velocity>${max_angular_vel}</max_angular_velocity>
      <max_linear_acceleration>${max_linear_acc}</max_linear_acceleration>
      <max_angular_acceleration>${max_angular_acc}</max_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- ========== Gazebo 激光雷达传感器 ========== -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>${lidar_update_rate}</update_rate>
      <topic>scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <min_angle>${lidar_min_angle}</min_angle>
            <max_angle>${lidar_max_angle}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${lidar_range_min}</min>
          <max>${lidar_range_max}</max>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${lidar_noise_stddev}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
